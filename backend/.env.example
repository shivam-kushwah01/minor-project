ATLASDB_URL=mongodb+srv://<user>:<password>@<cluster>/wonderlust
SECRET=change-me-to-a-long-random-string

# Frontend origin(s) allowed by CORS, comma-separated (only needed when the
# frontend calls the backend directly instead of through a proxy rewrite)
FRONTEND_URL=http://localhost:5173

# Cloudinary image storage (required in production; without it uploads go to ./uploads)
# Find these at https://console.cloudinary.com -> Settings -> API Keys
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=
CLOUD_FOLDER=wonderlust

# Only for `npm run seed`
SEED_OWNER_ID=
